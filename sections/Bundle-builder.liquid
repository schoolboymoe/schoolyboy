{% schema %}
{
  "name": "Parfym Bundle Builder",
  "settings": [
    {
      "type": "product",
      "id": "bundle_product",
      "label": "Välj bundle-produkt"
    },
    {
      "type": "text",
      "id": "bundle_product_name",
      "label": "Namn på bundle-produkten",
      "default": "Parfym Bundle"
    }
  ],
  "presets": [
    {
      "name": "Parfym Bundle",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<!-- Full-width background -->
<div class="bundle-section-full">
  <div class="bundle-builder">
    <!-- Left: 3-flask preview -->
    <div class="custom-image-container">
      <h2 class="image-title">3x bundle: Mix & Match</h2>
      <div class="bundle-preview">
        <img id="flask1" src="https://cdn.shopify.com/s/files/1/0784/2834/0552/files/nova_stock_utan_doft_namn.png?v=1755971897" alt="Parfym 1" class="bundle-preview__img">
        <img id="flask2" src="https://cdn.shopify.com/s/files/1/0784/2834/0552/files/nova_stock_utan_doft_namn.png?v=1755971897" alt="Parfym 2" class="bundle-preview__img">
        <img id="flask3" src="https://cdn.shopify.com/s/files/1/0784/2834/0552/files/nova_stock_utan_doft_namn.png?v=1755971897" alt="Parfym 3" class="bundle-preview__img">
      </div>
    </div>

    <!-- Right: selection form -->
    <div class="bundle-form-container">
      <h2 class="bundle-title">Välj tre parfymer och betala endast för två</h2>

      {% for i in (1..3) %}
        <div class="bundle-item">
          <label for="perfume{{ i }}">Parfym {{ i }}:</label>
          <select id="perfume{{ i }}" class="bundle-select" required>
            <option value="" disabled selected>Välj parfym</option>

            {% for perfume in collections['parfymer-bundle'].products %}
              {% unless perfume.tags contains "dold-bundle" %}

                {% assign in_stock = false %}
                {% for variant in perfume.variants %}
                  {% if variant.inventory_quantity > 0 or variant.inventory_policy == 'continue' %}
                    {% assign in_stock = true %}
                    {% break %}
                  {% endif %}
                {% endfor %}

                {% assign first_avail = perfume.first_available_variant %}

                <option
                  value="{{ perfume.title }}"
                  data-image="{{ perfume.featured_image | image_url: width: 800 }}"
                  data-price="{{ perfume.price | divided_by: 100.0 }}"
                  data-variant-id="{% if in_stock %}{{ first_avail.id }}{% endif %}"
                  {% unless in_stock %}disabled{% endunless %}>

                  {{ perfume.title }} - {{ perfume.price | money }}
                  {% unless in_stock %} (Slutsåld){% endunless %}
                </option>

              {% endunless %}
            {% endfor %}
          </select>
        </div>
      {% endfor %}

      <!-- Price & savings -->
      <div id="price-display" class="price-container">
        <p class="original-price-text">Ordinarie pris: <span id="original-price"></span></p>
        <p class="total-price-text">Totalpris: <span id="total-price"></span></p>
        <p class="savings-text">Du sparar: <span id="savings"></span></p>
      </div>

      <button id="add-bundle" class="bundle-button" disabled>Lägg bundle i varukorg</button>
    </div>
  </div>
</div>

<style>
.bundle-builder{
  display:flex; justify-content:center; align-items:stretch; max-width:1200px; margin:0 auto;
  background:#fff; border-radius:16px; color:#000; padding:40px; box-shadow:0 8px 20px rgba(0,0,0,.1);
  border:1px solid #e0e0e0; gap:24px;
}
.custom-image-container{flex:1; display:flex; flex-direction:column; gap:16px; padding:12px;}
.image-title{font-size:2em; font-weight:700; color:#000; margin:0 0 8px 6px;}
.bundle-preview{width:100%; display:flex; flex-direction:column; align-items:center; gap:20px;
  padding:18px; background:#fff; border:1px solid #e0e0e0; border-radius:12px; max-height:100%;}
.bundle-preview__img{width:clamp(160px,65%,300px); height:auto; object-fit:contain;
  filter:drop-shadow(0 10px 18px rgba(0,0,0,.45)); transition:opacity .18s ease, transform .2s ease;}
.bundle-preview__img:hover{transform:translateY(-3px);}
.bundle-form-container{flex:1.05; padding:20px; border:1px solid #e0e0e0; border-radius:12px;
  background:#fff; display:flex; flex-direction:column; justify-content:center;}
.bundle-section-full{background:#fff; padding:60px 20px;}
.bundle-title{text-align:center; margin-bottom:30px; font-size:2.2em; font-weight:700; letter-spacing:.5px; color:#000;}
.bundle-item{margin-bottom:20px;}
.bundle-item label{display:block; margin-bottom:8px; font-weight:500; font-size:1.05em; color:#000;}
.bundle-select{width:100%; padding:12px 15px; border-radius:10px; border:1px solid #e0e0e0;
  background:#fff; color:#000; font-size:1em; transition:border .2s, box-shadow .2s;}
.bundle-select:focus{outline:none; border-color:#666; box-shadow:0 0 10px rgba(0,0,0,.1);}
.bundle-select:disabled{color:#999; background:#f5f5f5;}
.bundle-button{width:100%; padding:16px; border-radius:12px; border:none;
  background:#000; color:#fff; font-weight:700; font-size:1.1em; cursor:pointer;
  box-shadow:0 6px 12px rgba(0,0,0,.1); transition:transform .2s, box-shadow .2s;}
.bundle-button:hover{transform:translateY(-2px); box-shadow:0 10px 18px rgba(0,0,0,.15);}
.bundle-button:disabled{background:#666; cursor:not-allowed;}
.price-container{text-align:center; margin:10px 0 20px; padding:15px; border-radius:10px;
  background:#fff; border:1px solid #e0e0e0; opacity:0; transition:opacity .5s ease;}
.price-container.visible{opacity:1;}
.original-price-text,.total-price-text{font-size:1.2em; font-weight:bold; color:#000; text-decoration:line-through; opacity:.7;}
.total-price-text{text-decoration:none; opacity:1;}
.savings-text{font-size:1em; color:#4CAF50; margin-top:5px;}
@media (max-width:992px){.bundle-preview__img{width:clamp(150px,60%,280px);}}
@media (max-width:768px){.bundle-builder{flex-direction:column; gap:20px; padding:20px;}
  .bundle-preview__img{width:clamp(140px,70%,260px);}}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const perfumeSelects = document.querySelectorAll('.bundle-select');
  const priceDisplay   = document.getElementById('price-display');
  const originalPriceEl= document.getElementById('original-price');
  const totalPriceEl   = document.getElementById('total-price');
  const savingsEl      = document.getElementById('savings');
  const addButton      = document.getElementById('add-bundle');

  function updateBundlePrice(){
    let prices=[], variantIds=[];
    perfumeSelects.forEach(s=>{
      const opt = s.options[s.selectedIndex];
      const p   = parseFloat(opt?.dataset.price);
      const vId = opt?.dataset.variantId;
      if(!isNaN(p) && vId){ prices.push(p); variantIds.push(vId); }
    });

    if(prices.length===3){
      priceDisplay.classList.add('visible');
      addButton.disabled=false;
      const original = prices.reduce((a,b)=>a+b,0);
      const cheapest = prices.slice().sort((a,b)=>a-b)[0];
      originalPriceEl.textContent=`${original.toFixed(2)} kr`;
      totalPriceEl.textContent   =`${(original-cheapest).toFixed(2)} kr`;
      savingsEl.textContent      =`${cheapest.toFixed(2)} kr`;
      addButton.textContent='Lägg till 3 parfymer i varukorg';
    }else{
      priceDisplay.classList.remove('visible');
      addButton.disabled=true;
      addButton.textContent='Välj 3 parfymer för att lägga till i varukorgen';
    }
  }

  /* ---------- bild-preview ---------- */
  const BLANK='https://cdn.shopify.com/s/files/1/0784/2834/0552/files/nova_stock_utan_doft_namn.png?v=1755971897';
  const previewMap=[
    {s:document.getElementById('perfume1'),i:document.getElementById('flask1')},
    {s:document.getElementById('perfume2'),i:document.getElementById('flask2')},
    {s:document.getElementById('perfume3'),i:document.getElementById('flask3')}
  ];
  function applyPreview(select,img){
    if(!select||!img)return;
    const opt=select.options[select.selectedIndex];
    const url=opt?.dataset?.image||BLANK;
    img.style.opacity=0;
    requestAnimationFrame(()=>{img.src=url; img.alt=opt?.value||'Blank flaska'; setTimeout(()=>img.style.opacity=1,50);});
  }
  function applyAllPreviews(){previewMap.forEach(m=>applyPreview(m.s,m.i));}

  /* ---------- events ---------- */
  perfumeSelects.forEach(s=>{
    s.addEventListener('change',()=>{updateBundlePrice(); applyAllPreviews();});
  });

  /* ---------- add to cart ---------- */
  addButton.addEventListener('click',()=>{
    const items=[];
    perfumeSelects.forEach(s=>{
      const opt=s.options[s.selectedIndex];
      const vId=opt?.dataset.variantId;
      if(vId)items.push({id:vId,quantity:1});
    });
    if(items.length!==3)return;

    fetch(window.Shopify.routes.root+'cart/add.js',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({items})
    })
    .then(r=>r.json())
    .then(()=>window.location='/cart')
    .catch(err=>console.error('Kunde inte lägga i varukorgen',err));
  });

  /* ---------- init ---------- */
  updateBundlePrice();
  applyAllPreviews();
});
</script>