{%- liquid assign s = section.settings -%}
<div class="nova nova-section nova-section--alt">
  <div class="nova-wrap">
    <div class="nova-shead" data-reveal>
      <h2 class="nova-h2">{{ s.heading | escape }}</h2>
      {%- if s.subheading != blank -%}<p>{{ s.subheading | escape }}</p>{%- endif -%}
    </div>
    <div class="nova-reviews">
      {%- for block in section.blocks -%}
        <figure class="nova-quote" data-reveal {{ block.shopify_attributes }}>
          <span class="nova-stars">★★★★★</span>
          <p>{{ block.settings.quote | escape }}</p>
          <cite>{{ block.settings.author | escape }}</cite>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Nova reviews",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Vad doftälskarna säger" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Över 2 400 verifierade omdömen, snittbetyg 4.8 av 5." }
  ],
  "blocks": [
    {
      "type": "quote", "name": "Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Pacifico håller hela arbetsdagen och får alltid komplimanger." },
        { "type": "text", "id": "author", "label": "Author", "default": "Elin H. · Verifierat köp" }
      ]
    }
  ],
  "presets": [{
    "name": "Nova reviews",
    "blocks": [
      { "type": "quote", "settings": { "quote": "Pacifico håller hela arbetsdagen och får alltid komplimanger. Galet bra för priset.", "author": "Elin H. · Verifierat köp" } },
      { "type": "quote", "settings": { "quote": "Oud Chaos är min nya signaturdoft. Djup, varm och otroligt vuxen.", "author": "Marcus L. · Verifierat köp" } },
      { "type": "quote", "settings": { "quote": "Beställde tre, betalade för två och leveransen kom på två dagar. Klockrent.", "author": "Sara N. · Verifierat köp" } }
    ]
  }]
}
{% endschema %}
