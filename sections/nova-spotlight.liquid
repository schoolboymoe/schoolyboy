{%- comment -%}
  NOVA spotlight: the signature scent with its note pyramid.
  Binds to a real product for price + link; text fields fill the notes.
{%- endcomment -%}

{%- liquid
  assign product = section.settings.product
  assign price_text = section.settings.price_text
  if price_text == blank and product != blank
    assign money = product.price | money_with_currency
    assign price_text = 'Extrait de parfum, 50 ml. ' | append: money
  endif
  assign cta_url = section.settings.cta_link
  if cta_url == blank and product != blank
    assign cta_url = product.url
  endif
-%}

<section class="nova-spotlight" id="NovaSpotlight-{{ section.id }}">
  <div class="nova-spotlight__wrap">
    <div class="nova-io">
      {%- if section.settings.label != blank -%}
        <span class="nova-label">{{ section.settings.label }}</span>
      {%- endif -%}
      <h2 class="nova-spotlight__heading">
        {%- if section.settings.heading != blank -%}
          {{ section.settings.heading }}
        {%- elsif product != blank -%}
          {{ product.title }}
        {%- endif -%}
      </h2>
      <div class="nova-spotlight__notes">
        <div class="nova-spotlight__note">
          <span class="nova-label">{{ section.settings.top_label }}</span>
          <strong>{{ section.settings.top_notes }}</strong>
        </div>
        <div class="nova-spotlight__note">
          <span class="nova-label">{{ section.settings.heart_label }}</span>
          <strong>{{ section.settings.heart_notes }}</strong>
        </div>
        <div class="nova-spotlight__note">
          <span class="nova-label">{{ section.settings.base_label }}</span>
          <strong>{{ section.settings.base_notes }}</strong>
        </div>
      </div>
      {%- if price_text != blank -%}
        <p class="nova-spotlight__price">{{ price_text }}</p>
      {%- endif -%}
      {%- if section.settings.cta_label != blank and cta_url != blank -%}
        <a class="nova-btn nova-btn--solid" href="{{ cta_url }}">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>
    <div class="nova-spotlight__media nova-io">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: section.settings.image_alt | escape, sizes: '(max-width: 767px) 100vw, 45vw', widths: '600, 1000, 1400, 1600' }}
      {%- elsif section.settings.image_url != blank -%}
        <img src="{{ section.settings.image_url }}" alt="{{ section.settings.image_alt | escape }}" loading="lazy">
      {%- elsif product != blank and product.featured_image != blank -%}
        {{ product.featured_image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: product.featured_image.alt | escape, sizes: '(max-width: 767px) 100vw, 45vw', widths: '600, 1000, 1400, 1600' }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NOVA Spotlight",
  "tag": "section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Small label",
      "default": "Signaturen"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave empty to use the product title."
    },
    {
      "type": "text",
      "id": "top_label",
      "label": "Top notes label",
      "default": "Topp"
    },
    {
      "type": "text",
      "id": "top_notes",
      "label": "Top notes",
      "default": "Bergamott, peppar"
    },
    {
      "type": "text",
      "id": "heart_label",
      "label": "Heart notes label",
      "default": "Hjärta"
    },
    {
      "type": "text",
      "id": "heart_notes",
      "label": "Heart notes",
      "default": "Damascus-ros, orrissmör"
    },
    {
      "type": "text",
      "id": "base_label",
      "label": "Base notes label",
      "default": "Bas"
    },
    {
      "type": "text",
      "id": "base_notes",
      "label": "Base notes",
      "default": "Amber, sandelträ, vanilj"
    },
    {
      "type": "text",
      "id": "price_text",
      "label": "Price line",
      "info": "Leave empty to build it from the product price."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Upptäck Ambre Royale"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link",
      "info": "Leave empty to use the product page."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Fallback image URL",
      "info": "Used when no image is picked."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Ambre Royale extrait de parfum med rå bärnsten"
    }
  ],
  "presets": [
    {
      "name": "NOVA Spotlight"
    }
  ]
}
{% endschema %}
