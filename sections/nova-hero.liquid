{%- comment -%}
  NOVA hero: full-bleed campaign image, left-anchored display type.
  Image priority: image picker > external URL > brand-ink fallback.
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading
  assign italic_word = section.settings.italic_word | strip
  if italic_word != blank and heading contains italic_word
    assign em_word = '<em>' | append: italic_word | append: '</em>'
    assign heading = heading | replace_first: italic_word, em_word
  endif
-%}

<section class="nova-hero" id="NovaHero-{{ section.id }}">
  <div class="nova-hero__media" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source media="(max-width: 767px)" srcset="{{ section.settings.image_mobile | image_url: width: 1200 }}">
        {%- endif -%}
        {{ section.settings.image | image_url: width: 2800 | image_tag: loading: 'eager', fetchpriority: 'high', alt: section.settings.image_alt | escape, sizes: '100vw', widths: '750, 1100, 1600, 2200, 2800' }}
      </picture>
    {%- elsif section.settings.image_url != blank -%}
      <picture>
        {%- if section.settings.image_url_mobile != blank -%}
          <source media="(max-width: 767px)" srcset="{{ section.settings.image_url_mobile }}">
        {%- endif -%}
        <img src="{{ section.settings.image_url }}" alt="{{ section.settings.image_alt | escape }}" loading="eager" fetchpriority="high">
      </picture>
    {%- endif -%}
  </div>
  <div class="nova-hero__wrap">
    <div class="nova-hero__content">
      {%- if heading != blank -%}
        <h1 class="nova-hero__heading nova-reveal">{{ heading }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="nova-hero__text nova-reveal d1">{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.cta_label != blank or section.settings.cta2_label != blank -%}
        <div class="nova-hero__ctas nova-reveal d2">
          {%- if section.settings.cta_label != blank -%}
            <a class="nova-btn nova-btn--solid" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }}</a>
          {%- endif -%}
          {%- if section.settings.cta2_label != blank -%}
            <a class="nova-btn nova-btn--ghost" href="{{ section.settings.cta2_link | default: routes.all_products_collection_url }}">{{ section.settings.cta2_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NOVA Hero",
  "tag": "section",
  "class": "nova-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (desktop)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image (mobile)"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Fallback image URL (desktop)",
      "info": "Used when no image is picked. Replace with an uploaded image for production."
    },
    {
      "type": "text",
      "id": "image_url_mobile",
      "label": "Fallback image URL (mobile)"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Nova Scents extrait de parfum"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Parfym för de mörka timmarna."
    },
    {
      "type": "text",
      "id": "italic_word",
      "label": "Word to set in italic",
      "default": "mörka"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Extraits de parfum inspirerade av världens mest eftertraktade dofter. Minst åtta timmar på huden."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary button label",
      "default": "Handla parfymer"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "Secondary button label"
    },
    {
      "type": "url",
      "id": "cta2_link",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "NOVA Hero"
    }
  ]
}
{% endschema %}
