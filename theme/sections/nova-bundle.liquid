{%- liquid assign s = section.settings -%}
<div class="nova nova-section nova-bundle">
  <div class="nova-wrap" data-reveal>
    {%- if s.kicker != blank -%}<span class="nova-kicker">{{ s.kicker | escape }}</span>{%- endif -%}
    <h2>{{ s.heading | escape }}</h2>
    {%- if s.body != blank -%}<p>{{ s.body | escape }}</p>{%- endif -%}
    {%- if s.button_label != blank -%}<a href="{{ s.button_link | default: '#' }}" class="nova-btn nova-btn--gold">{{ s.button_label | escape }}</a>{%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "Nova bundle band",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Mix & Match" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Köp 3, betala för 2" },
    { "type": "text", "id": "body", "label": "Body", "default": "Bygg ditt eget doftgarderob. Den billigaste av tre bjuder vi på, automatiskt i kassan." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Bygg ditt set" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Nova bundle band" }]
}
{% endschema %}
